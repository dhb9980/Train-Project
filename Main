//Declare Pins
const int trigPin = 13;
const int echoPin = 12;
const int irPin = 11;

//Testing variables
long duration;
float distance;
bool testing = false;

//Global variables
long duration_covered_us;
long duration_between_sensors;
long Distance_btw_sensors = 1;  // Declare this before upload. Measured in cm

//Ultrasound Variables
long when_us_covered;
long first_uncovered;
bool ultrasonic_covered = false;

long when_uncovered;
long duration_uncovered;
bool just_uncovered = false;


//IR Sensor Variables
bool ir_tripped = false;
bool passing = false;
long when_ir_tripped;

//TODO Motion Sensing



void setup() {
  //Ultrasonic
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  digitalWrite(trigPin, LOW);
  delay(1000);


  //Infared
	pinMode(irPin, INPUT);


  //Motion
  //TODO//

  //Debug
  Serial.begin(9600);
}

void loop() {

  //Detection Information for Ultrasonic
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  duration = pulseIn(echoPin, HIGH, 5000); //How long between out and in.


  //IR Sensor Detection, when ir pin is low it declares that the IR has been tripped
  if(digitalRead(irPin) == LOW && !passing)
      {
        Serial.println("Tripped IR");
        ir_tripped = true;
        when_ir_tripped = millis();
        passing = true;
      }

  
  //Nothing detected by Ultrasonic
  if (duration == 0) {
    if (testing) {
    Serial.println("No echo detected!");
    }


    //Stops the counter, returns duration covered (The end of the train has passed)
    if (ultrasonic_covered) {

      //First time after being that it is uncovered it waits 

      if (!just_uncovered) {

        //Thrown just in case their is a gap
        just_uncovered = true;
        when_uncovered = millis();

        //How long between covered and uncovered
        duration_covered_us = millis() - when_us_covered;
      }
    
      //Only fully print the distance when the gap is greater than t=1000.
      //Should help to prevent errors due to gaps in the train
      if (millis() - when_uncovered > 1000 && when_uncovered != 0) {
        ultrasonic_covered = false;
        passing = false;
        Serial.print("Train passed");
        Serial.println("");
        Serial.print("Ultrasonic covered for (millis):");
        Serial.println(duration_covered_us);
      }


    

    
    }
    
  }
  //Detec  ting when the ultrasonic is covered  
  else {

    //Get time between sensors
    if (ir_tripped) {
      duration_between_sensors = millis() - when_ir_tripped;
      Serial.print("Distance between Sensors (millis):");
      Serial.println(duration_between_sensors);
      ir_tripped = false;
    }


    //This is a Reset if the us sensor was previosuly uncovered
    when_uncovered = 0;
    just_uncovered = false;

    //Only sets 'when_us_covered' the first time the sensor detects it is covered
    if (!ultrasonic_covered) {
      when_us_covered = millis();
      ultrasonic_covered = true;
    }
    





    //Debug Distance information
    if (testing) {
      distance = duration * 0.0343 / 2.0;
      Serial.print("Duration: ");
      Serial.print(duration);
      Serial.print(" us   Distance: ");
      Serial.print(distance);
      Serial.println(" cm");
    }

  }



  delay(50);
}
